# File: .env.example
# Owner: BOTH CAN ADD
# Purpose: Show the frontend and backend environment variables required for local setup.
# What it is: A sample environment file for Learnova's local app configuration.

GOOGLE_CLIENT_ID=659342976819-kpgpnrm5vkc0q9u5bgb35giu399muvpd.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=659342976819-kpgpnrm5vkc0q9u5bgb35giu399muvpd.apps.googleusercontent.com
VITE_API_BASE_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql://postgres:tiger@localhost:5432/learnova
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnova
DB_USER=postgres
DB_PASSWORD=tiger
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# MongoDB migration target (domain routes remain on PostgreSQL until converted).
MONGODB_URI=mongodb://localhost:27017/?replicaSet=learnova-rs
MONGODB_DB=learnova_migration_dev
MONGODB_TIMEOUT_MS=5000
# Keep the working app on PostgreSQL during conversion. Mongo mode is for isolated
# migration tests until all domain routes and existing data are ready for cutover.
AUTH_STORAGE=postgres
ADMIN_STORAGE=postgres
COURSES_STORAGE=postgres
