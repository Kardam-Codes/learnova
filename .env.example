# File: .env.example
# Owner: BOTH CAN ADD
# Purpose: Show the frontend and backend environment variables required for local setup.
# What it is: A sample environment file for Learnova's local app configuration.

GOOGLE_CLIENT_ID=659342976819-kpgpnrm5vkc0q9u5bgb35giu399muvpd.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=659342976819-kpgpnrm5vkc0q9u5bgb35giu399muvpd.apps.googleusercontent.com
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=false

JWT_SECRET=replace-with-a-private-random-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Local MongoDB must run as a replica set for transactions.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=learnova-rs
MONGODB_DB=learnova
MONGODB_TIMEOUT_MS=5000
AUTH_STORAGE=mongo
ADMIN_STORAGE=mongo
COURSES_STORAGE=mongo
APPLICATION_WRITES_PAUSED=false
